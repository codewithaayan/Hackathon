# Leave blank until the team supplies a PostgreSQL/PostGIS connection string.
DATABASE_URL=
# Browser-facing FastAPI base URL used by the Next.js frontend.
NEXT_PUBLIC_API_BASE_URL=https://scenic-simultaneously-tower-genome.trycloudflare.com
# JSON arrays; use the real deployed origin and localhost only for local testing.
CORS_ORIGINS=["https://aetherioncityintel.netlify.app","http://localhost:3000"]
ALLOWED_HOSTS=["scenic-simultaneously-tower-genome.trycloudflare.com","localhost","127.0.0.1"]
DATABASE_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
PROVIDER_TIMEOUT_SECONDS=30
# Per-process cache of successful database reads. Set 0 to disable.
CACHE_TTL_SECONDS=30
CACHE_MAX_ENTRIES=128
MAX_REQUEST_BYTES=65536
# Chip-backed risk/simulator adapters. AI remains unavailable until a provider is injected.
TEAM_COMPONENTS_FACTORY=backend.team_components:build_components

# Outbound requests to the verified public data/catalog APIs only.
# These settings do not trigger fetching or choose datasets/locations.
EXTERNAL_TIMEOUT_SECONDS=30
EXTERNAL_MAX_RESPONSE_BYTES=2097152
# Static geospatial downloads are streamed to disk, never held in this JSON limit.
EXTERNAL_MAX_FILE_BYTES=33554432
EXTERNAL_CACHE_TTL_SECONDS=900
EXTERNAL_CACHE_MAX_ENTRIES=32
EXTERNAL_MIN_INTERVAL_SECONDS=1
